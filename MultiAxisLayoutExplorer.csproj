<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <!-- NETSDK1206: ProEssentials ships its native PEGRP64H.DLL under the old
         version-specific RID runtimes\win7-x64\native\. .NET 8+ warns that it
         no longer auto-resolves win7-x64 assets by default. We do NOT rely on
         that auto-resolution — the CopyNativeDll target below copies the DLL by
         explicit path — so the warning is cosmetic and is silenced here.
         Do NOT "fix" this by switching to RuntimeIdentifier win-x64: the package
         has no win-x64\native folder, so that would break the copy. Keep both
         this NoWarn and the win7-x64 path in CopyNativeDll. -->
    <NoWarn>$(NoWarn);NETSDK1206</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Version range: >= 10.0.0.28 and < 11.0.0. Floors at the current
         minimum, stays on the 10.x line (no surprise v11 breaking changes),
         and keeps restore deterministic so the CopyNativeDll target always
         finds runtimes\win7-x64\native\PEGRP64H.DLL. -->
    <PackageReference Include="ProEssentials.Chart.Net80.x64.Winforms" Version="[10.0.0.28,11.0.0)" />
  </ItemGroup>

  <!-- Copy native DLL to output directory -->
  <Target Name="CopyNativeDll" AfterTargets="Build">
    <Copy
      SourceFiles="$(OutDir)runtimes\win7-x64\native\PEGRP64H.DLL"
      DestinationFolder="$(OutDir)"
      SkipUnchangedFiles="true" />
  </Target>

</Project>
